{
    "routes": [
        {
            "route": "/api/*",
            "rewrite": "https://booktokclub-api-hcfxfzfxhsf8bbf7.centralus-01.azurewebsites.net/api/*",
            "allowedMethods": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH",
                "OPTIONS"
            ]
        },
        {
            "route": "/styles.css",
            "serve": "/styles.css"
        },
        {
            "route": "/*",
            "rewrite": "/index.html"
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
            "/api/*",
            "/assets/*"
        ]
    }
}