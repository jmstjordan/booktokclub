{
    "routes": [
      {
        "route": "/api/*",
        "allowedMethods": [
          "GET",
          "POST",
          "PUT",
          "DELETE",
          "PATCH",
          "OPTIONS"
        ]
      },
      {
        "route": "/*.js",
        "serve": "/*.js"
      },
      {
        "route": "/*.css",
        "serve": "/*.css"
      },
      {
        "route": "/assets/*",
        "serve": "/assets/*"
      }
    ],
    "navigationFallback": {
      "rewrite": "/index.html",
      "exclude": [
        "/api/*",
        "/assets/*",
        "/*.js",
        "/*.css"
      ]
    }
  }